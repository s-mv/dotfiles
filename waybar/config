{
  "layer": "top",
  "position": "bottom",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-right": [
    "filesystem",
    "pulseaudio",
    "keyboard-state",
    "memory",
    "cpu",
    "network",
    "clock",
    "battery"
  ],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60
  },

  "disk": {
    "interval": 25,
    "path": "/",
    "format": "<span color='#857C63'>/ </span>{percentage_used}%"
  },

  "pulseaudio": {
    "format": "<span color='#F0C674'>VOL </span>{volume}%",
    "format-muted": "<span color='#707880'>muted</span>",
    "scroll-step": 1
  },

  "memory": {
    "interval": 2,
    "format": "<span color='#F0C674'>RAM </span>{percentage}%"
  },

  "cpu": {
    "interval": 2,
    "format": "<span color='#F0C674'>CPU </span>{usage}%"
  },

  "network": {
    "interval": 5,
    "format-wifi": "<span color='#F0C674'>{ifname}</span> {essid} {ipaddr}",
    "format-ethernet": "<span color='#F0C674'>{ifname}</span> {ipaddr}",
    "format-disconnected": "<span color='#F0C674'>{ifname}</span> <span color='#707880'>disconnected</span>"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%",
    "states": {
      "warning": 20
    }
  },

  "clock": {
    "interval": 1,
    "format": "<span color='#F0C674'>{:%H:%M}</span>",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  }
}

